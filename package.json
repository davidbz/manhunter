{
  "name": "manhunter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:fast": "vitest run --project '!slow'",
    "test:e2e": "playwright test",
    "sim": "bun run --cwd packages/sim start",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "4.10.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
